@import "colors.rasi"

configuration {
    show-icons: true;
}

* {
    background-color: transparent;
}

window {
    anchor: center;
    height: 25%;
    width: 20%;
    background-color: @on-secondary-fixed;
    border-radius: 24px;
    border: 0px;
    font: "JetBrains Mono Nerd Font 16";
}

mainbox {
    spacing: 0px;
    padding: 0px;
    background-color: @on-secondary-fixed;
    border-radius: 24px;
    children:  [listview];
}

listview {
    scrollbar: false;
    margin: 0px 0px;
    padding: 0px 0px;
    spacing: 10px;
    border-radius: 16px;
    border: 0px;
    background-color: @on-secondary-fixed;
    columns: 1;
    lines: 1;
    flow: vertical;
    dynamic: false;
    fixed-height: false;
    fixed-columns: true;
    scroll-method: 1;
}

error-message {
    border: 24px;
}

entry, prompt, case-indicator {
    text-color: inherit;
    background-color: inherit;
}

prompt {
    margin: 0px 10px 0px 0px;
}

element {
    orientation: horizontal;
    padding: 18px 16px;
    vertical-align: 0.5;
    border-radius: 16px;
    background-color: @on-secondary;
    spacing: 12px;
}

element-text {
    vertical-align: 0.5;
    horizontal-align: 0.35;
    background-color: inherit;
    text-color: @inverse-surface;
}

element-icon {
    size: 40px;
    vertical-align: 0.5;
    horizontal-align: 0;
    background-color: inherit;
    text-color: @inverse-surface;
}

element.normal.normal, element.alternate.normal {
    background-color: transparent;
    text-color: @inverse-surface;
}

element.selected.normal {
    background-color: @primary;
}

element-text .active, element-text .urgent {
    text-color: @on-secondary-fixed;
}
