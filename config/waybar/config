{
    "layer": "bottom",
    "position": "top",
    //"mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "margin-top": 8,
    "margin-bottom": 0,
    "margin-left": 8,
    "margin-right": 8,
    "passthrough": false, 
    "spacing": 3,
    "fixed-center": true,
    "height": 35,

    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": [
        "clock",
        "tray",
        "hyprland/workspaces"
    ],

    "modules-right": [
        "pulseaudio",
        "hyprland/language",
        "group/bubble"
    ],

    "group/bubble": {
        "orientation": "inherit",
        "modules": [
            "group/gtools",
            "custom/notification",
            "custom/exit"
        ]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 10
    }
}

