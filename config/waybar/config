{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "margin-top": 8,
    "margin-bottom": -24,
    "passthrough": false, 
    "spacing": 8,

    "include": [
        "~/.config/waybar/modules.json"
    ],

    "modules-left": [
        "clock",
        "tray",
        "hyprland/workspaces"
    ],

    "modules-right": [
        "pulseaudio",
        "hyprland/language",
        "group/bubble"
    ],

    "group/bubble": {
        "orientation": "inherit",
        "modules": [
            "group/gtools",
            "custom/notification",
            "custom/exit"
        ]
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "   {:%R}"
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "󱧑 ",
        "tooltip-format": "{ifname} via {gwaddr}  ",
        "format-linked": "{ifname} (No IP)  ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}"
    },

    "pulseaudio": {
        "format": "󰕾",
        "format-bluetooth": "{volume}%  {icon}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "󰋋 ",
            "hands-free": "󰋋 ",
            "headset": "󰋋 ",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 3
    },

    "hyprland/language": {
        "format": "{}",
        "format-en": "en",
        "format-ru": "ru"
    }
}
